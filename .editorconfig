root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
# intellij_idea rather than ktlint_official: the latter rejects the
# `fun name() = runTest { ... }` form that AGENTS.md uses in its own example.
ktlint_code_style = intellij_idea
# @Composable functions are PascalCase by convention.
ktlint_function_naming_ignore_when_annotated_with = Composable

[*.{xml,toml,yml,yaml}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
