<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Vendor APIs are all HTTP. The wake lock still lands with the feature that needs it;
         the notification listener below needs no permission of its own, only the user-granted
         notification-access toggle. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The two apps the launcher tiles open. Targeting API 30+ means a package we have not
         named here is invisible to us: getLaunchIntentForPackage returns null for it, and the
         tile would read "not installed" on a tablet that has the app. Named one by one rather
         than as an <intent> query for every launchable app, because these two are the whole
         list. Both packages are read off the tablet, and the grant this block produces is
         verified there too — see docs/domonap.md and docs/xiaomi.md. -->
    <queries>
        <package android:name="com.domonap.app" />
        <package android:name="com.xiaomi.smarthome" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DomovoyHub">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- BIND_NOTIFICATION_LISTENER_SERVICE is a signature permission the system holds; naming
             it here is the guard that says only the system may bind this service. Exported for the
             same reason: the binder is system_server, not us. -->
        <service
            android:name=".integrations.domonap.DomonapCallListener"
            android:exported="true"
            android:label="@string/domonap_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
