<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Vendor HTTP and authenticated Tuya LAN sockets. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Select Wi-Fi explicitly for Tuya LAN while a VPN is active. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The two apps the launcher tiles open. Targeting API 30+ means a package we have not
         named here is invisible to us: getLaunchIntentForPackage returns null for it, and the
         tile would read "not installed" on a tablet that has the app. Named one by one rather
         than as an <intent> query for every launchable app, because these two are the whole
         list. Both packages are read off the tablet, and the grant this block produces is
         verified there too — see docs/domonap.md and docs/xiaomi.md. -->
    <queries>
        <package android:name="com.domonap.app" />
        <package android:name="com.xiaomi.smarthome" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DomovoyHub">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".kiosk.PanelDeviceAdmin"
            android:exported="true"
            android:label="@string/panel_device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/panel_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- BIND_NOTIFICATION_LISTENER_SERVICE is a signature permission the system holds; naming
             it here is the guard that says only the system may bind this service. Exported for the
             same reason: the binder is system_server, not us. -->
        <service
            android:name=".integrations.domonap.DomonapCallListener"
            android:exported="true"
            android:label="@string/domonap_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
